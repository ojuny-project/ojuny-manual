#!/usr/bin/env sh
set -eu

home=${OJUNY_MANUAL_HOME:-}
if [ -z "$home" ]; then
  script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  if [ -d "$script_dir/../share/ojuny-manual/book" ]; then
    home=$(CDPATH= cd -- "$script_dir/../share/ojuny-manual" && pwd)
  elif [ -d "$script_dir/../book" ]; then
    home=$(CDPATH= cd -- "$script_dir/.." && pwd)
  else
    home=$script_dir/../share/ojuny-manual
  fi
fi

book=$home/book
index=$book/index.html
if [ -d "$home/md" ]; then
  md_dir=$home/md
else
  md_dir=$home/src
fi
summary=$md_dir/SUMMARY.md

die() {
  printf 'ojuny-manual: %s\n' "$1" >&2
  exit 1
}

[ -f "$index" ] || die "book not found at $index"

usage() {
  cat <<'EOF'
usage: ojuny-manual [--gui | --tty | --path | --list | --serve]

  (no option)  open the book in a browser with a display, otherwise in the terminal
  --gui        open the book in a browser
  --tty        read the book in the terminal even when a display is set
  --path       print the path to the installed Markdown directory
  --list       print the chapter titles, one per line
  --serve      serve the book on 127.0.0.1 and print the URL
EOF
}

open_gui() {
  url=file://$index
  if command -v xdg-open >/dev/null 2>&1 && xdg-open "$url" >/dev/null 2>&1; then
    return 0
  fi
  if [ -n "${BROWSER:-}" ] && $BROWSER "$url" >/dev/null 2>&1; then
    return 0
  fi
  printf '%s\n' "$index"
}

summary_rows() {
  while IFS= read -r line; do
    case $line in
      *']('*)
        path=${line#*](}
        path=${path%%)*}
        title=${line#*[}
        title=${title%%]*}
        case $path in
          *.md) printf '%s\t%s\n' "$path" "$title" ;;
        esac
        ;;
    esac
  done <"$summary"
}

open_tty() {
  [ -f "$summary" ] || die "chapter list not found at $summary"
  if ! command -v fzf >/dev/null 2>&1 || ! command -v bat >/dev/null 2>&1; then
    printf 'ojuny-manual: the TTY reader needs both fzf and bat.\n' >&2
    list_chapters
    exit 1
  fi
  choice=$(
    summary_rows |
      fzf --delimiter='\t' --with-nth=2 --layout=reverse \
        --preview="bat --style=plain --color=always --paging=never $md_dir/{1}"
  ) || exit 0
  [ -n "$choice" ] || exit 0
  tab=$(printf '\t')
  path=${choice%%"$tab"*}
  bat --style=plain --color=always "$md_dir/$path" |
    fzf --layout=reverse --bind='esc:abort,enter:abort' --no-input --ansi --disabled --preview-window=hidden --prompt=''
}

list_chapters() {
  [ -f "$summary" ] || die "chapter list not found at $summary"
  tab=$(printf '\t')
  summary_rows | while IFS= read -r row; do
    printf '%s\n' "${row#*"$tab"}"
  done
}

serve() {
  command -v python3 >/dev/null 2>&1 || die 'python3 is required for --serve'
  # Bind once so the kernel picks a free port, then serve on it.
  port=$(python3 -c 'import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()')
  printf 'http://127.0.0.1:%s/\n' "$port"
  cd "$book"
  exec python3 -m http.server --bind 127.0.0.1 "$port"
}

case "${1:-}" in
  '')
    if [ -t 1 ] && [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
      open_tty
    else
      open_gui
    fi
    ;;
  --gui) open_gui ;;
  --tty) open_tty ;;
  --path) printf '%s\n' "$md_dir" ;;
  --list) list_chapters ;;
  --serve) serve ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
